{
  "name": "kirothon-team-024",
  "private": true,
  "version": "0.1.0",
  "description": "똑Pay — 결제·무료체험 끝나기 전에 먼저 묻고, 더 싼 결제 경로와 해지 방법을 알려 주고, 가족 동의를 모아 다음 청구까지 확인하는 구독 관리 웹앱 (KIROTHON 2026 team-024)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bot:reset": "tsx scripts/bot-patrol.ts --reset --dry",
    "bot:patrol": "tsx scripts/bot-patrol.ts",
    "bot:demo": "tsx scripts/demo-scenario.ts",
    "mcp": "node scripts/mcp-launch.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/trace-check.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}